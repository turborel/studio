{
  "name": "turborel-studio",
  "private": true,
  "version": "0.0.0",
  "description": "Turborel Studio, Turborel's desktop database IDE for its servers and embedded databases: its front end.",
  "license": "BSD-2-Clause-Patent",
  "repository": "github:turborel/studio",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@glideapps/glide-data-grid": "6.0.3",
    "@lezer/highlight": "1.2.5",
    "@phosphor-icons/react": "2.1.10",
    "@tauri-apps/api": "2.12.5",
    "@xyflow/react": "13.0.3",
    "dockview-react": "8.9.1",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-responsive-carousel": "3.2.23"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@linaria/utils": {
      "minimatch": "11.0.4"
    },
    "@linaria/react": {
      "minimatch": "11.0.4"
    }
  }
}
