{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the application's own commands and the events it listens to, nothing else (RULES.md R-SEC-5).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-open-connection",
    "allow-close-connection",
    "allow-reconnect",
    "allow-cancel-statement",
    "allow-run-statement",
    "allow-fetch-rows",
    "allow-close-result",
    "allow-result-value",
    "allow-session-state",
    "allow-set-autocommit",
    "allow-ping-connection",
    "allow-list-threads",
    "allow-list-saved-connections",
    "allow-save-connection",
    "allow-delete-saved-connection",
    "allow-open-saved-connection",
    "allow-keychain-status",
    "allow-load-settings",
    "allow-save-settings",
    "allow-load-layout",
    "allow-save-layout",
    "allow-forget-layout",
    "allow-set-aside-notices",
    "allow-log-failure",
    "allow-catalog-schemas",
    "allow-catalog-objects",
    "allow-catalog-table",
    "allow-catalog-routine",
    "allow-catalog-type",
    "allow-catalog-graphs",
    "allow-catalog-analysis",
    "allow-catalog-usage",
    "allow-catalog-security",
    "allow-catalog-dependencies",
    "allow-catalog-search",
    "allow-catalog-definition",
    "allow-save-text-file",
    "allow-export-query",
    "allow-save-binary-file",
    "allow-open-model-file",
    "allow-choose-import-file",
    "allow-preview-import",
    "allow-import-rows",
    "allow-notify-finished",
    "allow-sql-words",
    "allow-split-script",
    "allow-statement-scope",
    "allow-judge-script",
    "allow-statement-parameters",
    "allow-search-history",
    "allow-record-history",
    "allow-clear-history",
    "allow-load-worksheets",
    "allow-keep-worksheets",
    "allow-list-queries",
    "allow-keep-query",
    "allow-forget-query",
    "allow-list-reports",
    "allow-keep-report",
    "allow-forget-report",
    "allow-open-sql-file",
    "allow-read-sql-file",
    "allow-write-sql-file",
    "allow-project-folders",
    "allow-add-project-folder",
    "allow-remove-project-folder",
    "allow-project-files"
